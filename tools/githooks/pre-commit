#!/bin/sh
# git pre-commit hook (audit C1) -- runs the secret/encoding guard on EVERY commit path,
# closing the "plain git commit bypasses commit.ps1" gap. Enabled via: core.hooksPath=tools/githooks
#
# SAFE-BY-DESIGN: blocks ONLY when the guard signals a confirmed violation with exit code 7.
# Any other outcome -- guard clean (0), guard crash, powershell missing -- ALLOWS the commit, so
# a bug in the guard can never halt the hub's autonomous commit stream (commit.ps1 stays the
# fail-closed primary). Override a confirmed false positive with: git commit --no-verify.
root="$(git rev-parse --show-toplevel 2>/dev/null)"
guard="$root/tools/githooks/precommit-guard.ps1"
[ -f "$guard" ] || exit 0

if command -v powershell.exe >/dev/null 2>&1; then
  PS=powershell.exe
elif command -v pwsh >/dev/null 2>&1; then
  PS=pwsh
else
  exit 0   # no PowerShell available -> fail open
fi

"$PS" -NoProfile -ExecutionPolicy Bypass -File "$guard"
code=$?
if [ "$code" = "7" ]; then
  echo "[pre-commit] BLOCKED: staged secret/encoding violation (above). Remove it and reference by path (PROTOCOL 7)." >&2
  echo "[pre-commit] For a CONFIRMED false positive only: git commit --no-verify" >&2
  exit 1
fi
exit 0
