{
  "name": "ai-usage-widget",
  "productName": "AI Usage Widget",
  "version": "2.0.0-alpha.0",
  "description": "Windows taskbar widget showing AI subscription usage for multiple accounts",
  "private": true,
  "author": "Simon",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "dist:dir": "pnpm run build && electron-builder --win --dir",
    "dist": "pnpm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "koffi": "3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.13.4",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
