 ```bash
-# 발견 리포트에 근거 없는 항목이 없는지 마지막 그렙 (file:line 패턴 강제)
-grep -nE "BLOCKER|DROPOUT|DISTRUST|CONFUSION" persona-sim-*.html 2>/dev/null \
-  | grep -vE "\.tsx:[0-9]+|\.ts:[0-9]+|\.jsx?:[0-9]+" \
-  && echo "⚠ 근거(file:line) 없는 발견 존재 — 보강 필요" \
-  || echo "OK — 모든 발견에 코드 근거 있음"
+# 발견 리포트 자가 점검 — 막는 쪽이 기본이다(fail-closed).
+#
+# 2026-09-20 에 이 자리가 fail-open 이었다: 예전 형태는
+#   grep -nE "BLOCKER|…" persona-sim-*.html | grep -vE "\.tsx:[0-9]+|…" && 경고 || echo OK
+# 였는데, **리포트 파일이 아예 없으면** 앞 grep 이 아무것도 못 찾아 `||` 분기로 빠져
+# "OK — 모든 발견에 코드 근거 있음" 을 종료코드 0 으로 출력했다.
+# 즉 아무 일도 안 한 실행이 자가 점검을 통과했다. 세 경우를 갈라서 본다.
+set -u
+shopt -s nullglob 2>/dev/null || true
+reports=(persona-sim-*.html)
+
+if [ ${#reports[@]} -eq 0 ]; then
+  echo "❌ 리포트가 없다 — 점검할 대상 자체가 없다. 실행이 끝나지 않은 것이다."
+  exit 1
+fi
+
+# wc 로 센다 - bc·paste 는 없는 환경이 있다(2026-09-20 Git Bash 에서 bc 없음으로 정상 리포트까지 막혔다)
+findings=$(grep -hE "BLOCKER|DROPOUT|DISTRUST|CONFUSION" "${reports[@]}" | wc -l | tr -d ' ')
+if [ "${findings:-0}" -eq 0 ]; then
+  echo "❌ 발견이 0건이다 — 정말 0건이면 '어느 화면을 어느 페르소나로 걸었는지'를 리포트에 적고 그 근거로 통과시켜라."
+  exit 1
+fi
+
+bad=$(grep -nE "BLOCKER|DROPOUT|DISTRUST|CONFUSION" "${reports[@]}" \
+      | grep -vE "\.tsx:[0-9]+|\.ts:[0-9]+|\.jsx?:[0-9]+" || true)
+if [ -n "$bad" ]; then
+  echo "❌ 근거(file:line) 없는 발견 $(printf '%s\n' "$bad" | wc -l)건 — 보강 필요"
+  printf '%s\n' "$bad" | head -20
+  exit 1
+fi
+
+echo "OK — 발견 ${findings}건 전부에 코드 근거 있음"
 ```
 
