{
  "name": "simonk-runtime",
  "description": "Shared runtime (bin scripts, browse/design/pdf binaries, chrome extension) used by the SimonK-stack skills derived from garrytan/gstack.",
  "upstream": "https://github.com/garrytan/gstack",
  "upstream_commit": "96764e80",
  "upstream_version": "1.91.9.0",
  "license": "MIT (see LICENSE: garrytan/gstack provenance)",
  "install_root": "~/.simonk/runtime",
  "state_root": "~/.simonk/state",
  "state_env": ["GSTACK_HOME", "GSTACK_STATE_DIR", "GSTACK_STATE_ROOT"],
  "config": {"update_check": "false", "telemetry": "off", "auto_upgrade": "false"},
  "compiled": [
    "browse/src/cli.ts -> browse/dist/browse",
    "browse/src/find-browse.ts -> browse/dist/find-browse",
    "design/src/cli.ts -> design/dist/design",
    "make-pdf/src/cli.ts -> make-pdf/dist/pdf",
    "bin/gstack-global-discover.ts -> bin/gstack-global-discover",
    "browse/scripts/build-node-server.sh -> browse/dist/server-node.mjs"
  ],
  "path_patch": {".claude/skills/gstack": ".simonk/runtime"}
}
